# EGY-SCOUT V8 Pluggable Provider Configuration
# Wave 0 ($0 Local / HF Spaces / Kaggle / Colab) -> Wave 1 (Modal L4 + Cloudflare R2)

# ASCII-safe root directory for datasets, weights, cache, and Parquet outputs
EGY_SCOUT_DATA_DIR=D:\egy-scout-data

# Compute Provider: auto | local | kaggle | colab | modal_l4
EGY_SCOUT_COMPUTE_PROVIDER=local

# Storage Provider: local | r2 (Wave 1)
EGY_SCOUT_STORAGE_PROVIDER=local

# API & Frontend URLs
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
EGY_SCOUT_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Wave 1 Paid Cloud Secrets (Uncomment after Pre-Seed)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=egy-scout-v8
